{% from 'govuk/components/tag/macro.njk' import govukTag %}
{% from 'govuk/components/summary-list/macro.njk' import govukSummaryList %}
{% from 'govuk/components/select/macro.njk' import govukSelect %}
{% macro taskCard(task) %}
<article class='govuk-summary-card'>
  <div class='govuk-summary-card__title-wrapper'>
    <h2 class='govuk-summary-card__title'>{{ task.title }}</h2>
    {% if task.status == 'TODO' %}
    {{ govukTag({
      text: 'To do',
      classes: 'govuk-tag--grey'
    }) }}
    {% elif task.status == 'IN_PROGRESS' %}
    {{ govukTag({
      text: 'In progress',
      classes: 'govuk-tag--yellow'
    }) }}
    {% elif task.status == 'COMPLETED' %}
    {{ govukTag({
      text: 'Completed',
      classes: 'govuk-tag--green'
    }) }}
    {% endif %}
  </div>
  <div class='govuk-summary-card__content'>
    {{ govukSummaryList({
      rows: [
        {
          key: {
            text: 'Description'
          },
          value: {
            text: task.description
          }
        },
        {
          key: {
            text: 'Deadline'
          },
          value: {
            text: task.deadline | replace('T', ' at ')
          }
        }
      ]
    }) }}

    <div class='task-card__actions'>
      <form class='task-card__status-form' action='/tasks/{{ task.id }}/status' method='post'>
        {{ govukSelect({
          id: 'status-' + task.id,
          name: 'status',
          value: task.status,
          label: { text: 'Status' },
          items: [
            { value: 'TODO', text: 'To do' },
            { value: 'IN_PROGRESS', text: 'In progress' },
            { value: 'COMPLETED', text: 'Completed' }
          ]
        }) }}
        <button class='govuk-button' type='submit'>Update</button>
      </form>
      <form
        action='/tasks/{{ task.id }}/delete'
        method='post'
        onsubmit='return confirm("Are you sure you want to delete this task?")'
      >
        <button class='govuk-button govuk-button--warning' type='submit'>
          Delete task
        </button>
      </form>
    </div>
  </div>
</article>
{% endmacro %}
