{% from 'macros/task-card.njk' import taskCard %}
{% from 'macros/create-task-form.njk' import createTaskForm %}
<!DOCTYPE html>
<html lang='en' class='govuk-template'>
  <head>
    <link rel='stylesheet' href='/govuk/govuk-frontend.min.css'>
    <link rel='stylesheet' href='/stylesheets/application.css'>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <title>Task Tracker</title>
  </head>
  <body class='govuk-template__body'>
    <header class='govuk-header'>
      <div class='govuk-header__container govuk-width-container'>
        <div class='govuk-header__logo'>
          <a href='/' class='govuk-header__link govuk-header__link--homepage'>
            <span class='govuk-header__logotype'>Task Tracker</span>
          </a>
        </div>
      </div>
    </header>
    <div class='govuk-width-container'>
      <main class='govuk-main-wrapper' id='main-content'>
        <h1 class='govuk-heading-xl'>Task Tracker</h1>
        {{ createTaskForm() }}
        {% if tasks.length %}
          {% for task in tasks %}
            {{ taskCard(task) }}
          {% endfor %}
        {% else %}
          <div class='govuk-inset-text'>
            <p class='govuk-body'>No tasks yet. Tasks will appear here when they are created.</p>
          </div>
        {% endif %}
      </main>
    </div>
    <script>
      const titleField = document.querySelector('#task-title');
      const titleCount = document.querySelector('#task-title-count');
      const descriptionField = document.querySelector('#task-description');
      const descriptionCount = document.querySelector('#task-description-count');

      titleField.addEventListener('input', () => {
        const remaining = 50 - titleField.value.length;
        titleCount.textContent = `You have ${remaining} characters remaining`;
      });

      descriptionField.addEventListener('input', () => {
        const remaining = 255 - descriptionField.value.length;
        descriptionCount.textContent = `You have ${remaining} characters remaining`;
      });
    </script>
  </body>
</html>
